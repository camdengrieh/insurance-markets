# Used by BuildKit when the Dockerfile is deploy/linker/Dockerfile and the context is the repo root.
# The Dockerfile copies only package.json, the lockfile, tsconfig.json, src/, pm/ and the build script;
# this keeps everything else (toolchain, dependencies, data, docs, other apps) out of the context upload.
.git
.tools
.claude
.playwright
.playwright-browsers
node_modules
**/node_modules
dist
**/dist
app
bridge
relay
docs
scripts
test
**/data
**/*.sqlite
**/*.sqlite-wal
**/*.sqlite-shm
**/*.lock
.env
.env.*
