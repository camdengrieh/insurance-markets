     "description": "\"prepare\" builds the item and returns what to sign; \"submit\" sends it once it is signed.",
     "enum": [
      "prepare",
      "submit"
     ],
     "type": "string"
    }
   },
   "required": [
    "step"
   ],
   "type": "object"
  },
