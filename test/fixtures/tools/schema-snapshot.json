  },
  "description_sha256": "23a85346a4f1f81171e080c2d00031c8a40bbfff6f0ccae1a889249ba935808a",
  "input": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "additionalProperties": false,
   "properties": {
    "owner": {
     "description": "Only for step \"prepare\": the PayBox EVM wallet address that owns the XO account.",
     "pattern": "^0x[0-9a-fA-F]{40}$",
     "type": "string"
    },
    "prepared_id": {
     "description": "Only for step \"submit\": the prepared_id the prepare step returned.",
     "pattern": "^[0-9a-f]{32}$",
     "type": "string"
    },
    "signature": {
     "anyOf": [
      {
       "pattern": "^0x[0-9a-fA-F]{130}$",
       "type": "string"
      },
      {
       "additionalProperties": false,
       "properties": {
        "r": {
         "pattern": "^0x[0-9a-fA-F]{64}$",
         "type": "string"
        },
        "recovery_id": {
         "anyOf": [
          {
           "const": 0,
           "type": "number"
          },
          {
           "const": 1,
           "type": "number"
          },
          {
           "const": 27,
           "type": "number"
          },
          {
           "const": 28,
           "type": "number"
          }
         ]
        },
        "s": {
         "pattern": "^0x[0-9a-fA-F]{64}$",
         "type": "string"
        }
       },
       "required": [
        "r",
        "s",
        "recovery_id"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "r": {
         "pattern": "^0x[0-9a-fA-F]{64}$",
         "type": "string"
        },
        "s": {
         "pattern": "^0x[0-9a-fA-F]{64}$",
         "type": "string"
        },
        "v": {
         "anyOf": [
          {
           "const": 0,
           "type": "number"
          },
          {
           "const": 1,
           "type": "number"
          },
          {
           "const": 27,
           "type": "number"
          },
          {
           "const": 28,
           "type": "number"
          }
         ]
        }
       },
       "required": [
