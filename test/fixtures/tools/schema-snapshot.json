 "xo_prepare_order": {
  "title": "Prepare an XO order",
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": false,
   "openWorldHint": true,
   "readOnlyHint": false
  },
  "meta": {
   "anthropic/requiresUserInteraction": true
  },
  "description_sha256": "be5adb6558d514329a80a54c73044e7bfd08448df1516cb8ea96ee2f2713cb58",
  "input": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "additionalProperties": false,
   "properties": {
    "owner": {
     "description": "The PayBox EVM wallet address that owns the XO account. The XO account is derived from it.",
     "pattern": "^0x[0-9a-fA-F]{40}$",
     "type": "string"
    },
    "post_only": {
     "description": "Only for GTD: reject the order instead of letting it take liquidity (a maker-only order).",
     "type": "boolean"
    },
    "price": {
     "description": "Limit price in dollars per share, 0.001 to 0.999 in steps of 0.001, such as \"0.55\". It is also the implied probability.",
     "pattern": "^0\\.[0-9]{1,3}$",
     "type": "string"
    },
    "shares": {
     "description": "Order size in shares, a multiple of 0.001, such as \"10\" or \"2.5\".",
     "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,6})?$",
     "type": "string"
    },
    "side": {
     "description": "BUY pays USDC.e for shares; SELL sells shares you hold.",
     "enum": [
      "BUY",
      "SELL"
     ],
     "type": "string"
    },
    "tif": {
     "description": "GTD (default) rests on the book until its expiry. FOK fills completely at once or not at all; FAK fills what it can at once. FOK and FAK are taker orders and the submit call can take a few seconds.",
     "enum": [
      "GTD",
      "FOK",
      "FAK"
     ],
     "type": "string"
    },
    "token_id": {
     "description": "The outcome token to trade: a decimal string, from outcomes[].token_id in xo_get_market.",
     "pattern": "^[1-9][0-9]{0,77}$",
     "type": "string"
    },
    "ttl_s": {
     "description": "How long the signed order stays valid, in seconds. Omit it for the relay's default (300). The operator's XO_ORDER_EXPIRY_SECONDS is the upper limit. A signed order cannot be cancelled on chain, so keep it short.",
     "maximum": 3600,
     "minimum": 1,
     "type": "integer"
    }
   },
   "required": [
    "owner",
    "token_id",
    "side",
    "price",
    "shares"
   ],
   "type": "object"
  },
  "output": {
   "sha256": "9fdff85e6c295d47ca3ef0a5e1fec67243b6dd5f8708a36502e970dd40253d31",
   "properties": [
    "account",
    "code",
    "digest_tag",
    "flag",
    "inner_hash_tag",
    "message",
    "next_action",
    "outcome",
    "owner",
    "prepared",
    "relay_details",
    "seconds_until_expiry",
    "sign_instructions",
    "sign_with_paybox",
    "step",
    "unproven_capabilities",
    "verification",
    "warnings"
   ],
   "required": [
    "code",
    "message",
    "next_action",
    "outcome",
    "unproven_capabilities",
    "warnings"
   ]
  }
 },
 "xo_submit_order": {
  "title": "Submit a signed XO order",
  "annotations": {
   "destructiveHint": true,
   "idempotentHint": false,
   "openWorldHint": true,
   "readOnlyHint": false
  },
  "meta": {
   "anthropic/requiresUserInteraction": true
  },
  "description_sha256": "cd8aa073a79449dfd6d5f39d5f376d363bb1f1b6e4806c9e90b3094706fcb93c",
  "input": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "additionalProperties": false,
   "properties": {
    "prepared_id": {
     "description": "The prepared_id xo_prepare_order returned.",
     "pattern": "^[0-9a-f]{32}$",
     "type": "string"
    },
    "signature": {
     "anyOf": [
      {
       "pattern": "^0x[0-9a-fA-F]{130}$",
       "type": "string"
      },
      {
       "additionalProperties": false,
       "properties": {
        "r": {
         "pattern": "^0x[0-9a-fA-F]{64}$",
         "type": "string"
        },
        "recovery_id": {
         "anyOf": [
          {
           "const": 0,
           "type": "number"
          },
          {
           "const": 1,
           "type": "number"
          },
          {
           "const": 27,
           "type": "number"
          },
          {
           "const": 28,
           "type": "number"
          }
         ]
        },
        "s": {
         "pattern": "^0x[0-9a-fA-F]{64}$",
         "type": "string"
        }
       },
       "required": [
        "r",
        "s",
        "recovery_id"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "r": {
         "pattern": "^0x[0-9a-fA-F]{64}$",
         "type": "string"
        },
        "s": {
         "pattern": "^0x[0-9a-fA-F]{64}$",
         "type": "string"
        },
        "v": {
         "anyOf": [
          {
           "const": 0,
           "type": "number"
          },
          {
           "const": 1,
           "type": "number"
          },
          {
           "const": 27,
           "type": "number"
          },
          {
           "const": 28,
           "type": "number"
          }
         ]
        }
       },
       "required": [
        "r",
        "s",
        "v"
       ],
       "type": "object"
      }
     ],
     "description": "The signature PayBox returned for sign_with_paybox (a 65-byte 0x hex string, or its r and s with recovery_id or v), exactly as PayBox gave it."
    }
   },
   "required": [
    "prepared_id",
    "signature"
   ],
   "type": "object"
  },
  "output": {
   "sha256": "b9e33792fea5600d11a6494cee9f095c8cff8cc96c51be9a80f975138707c72c",
   "properties": [
    "account",
    "code",
    "flag",
    "message",
    "next_action",
    "order_hash",
    "outcome",
    "owner",
    "relay_details",
    "step",
    "submission",
    "unproven_capabilities",
    "warnings"
   ],
   "required": [
    "code",
    "message",
    "next_action",
    "outcome",
    "unproven_capabilities",
    "warnings"
   ]
  }
 },
